<UserControl x:Class="SilkySouls.Views.EnemyTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:SilkySouls.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="500">
    <UserControl.Resources>
        <converters:BooleanAndConverter x:Key="BooleanAndConverter" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <converters:ImmuneFillConverter x:Key="ImmuneFillConverter" />
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Border Grid.Row="0"
                BorderThickness="1"
                BorderBrush="#333"
                CornerRadius="3">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        BorderThickness="1"
                        BorderBrush="#333"
                        CornerRadius="3"
                        Margin="0,0,5,0">
                    <StackPanel Margin="10">
                        <TextBlock Text="Global Enemy Options"
                                   FontWeight="Bold"
                                   Margin="0,0,0,10" />

                        <UniformGrid Columns="1">
                            <CheckBox Content="Disable AI"
                                      IsChecked="{Binding IsDisableAiEnabled}"
                                      Margin="0,2" />

                            <CheckBox Content="All No Damage"
                                      IsChecked="{Binding IsAllNoDamageEnabled}"
                                      Margin="0,2" />

                            <CheckBox Content="All No Death"
                                      IsChecked="{Binding IsAllNoDeathEnabled}"
                                      Margin="0,2" />
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        BorderThickness="1"
                        BorderBrush="#333"
                        CornerRadius="3"
                        Margin="5,0,0,0">
                    <StackPanel Margin="5">
                        <TextBlock Text="Misc"
                                   FontWeight="Bold"
                                   Margin="0,0,0,5" />

                        <UniformGrid Columns="1">
                            <CheckBox Content="Stop 4 kings spawn timer"
                                      IsChecked="{Binding Is4KingsTimerStopped}"
                                      Margin="0,2" />
                        </UniformGrid>

                        <TextBlock Text="Hitless Practice"
                                   FontWeight="Bold"
                                   Margin="0,8,0,4" />

                        <UniformGrid Columns="1">
                            <CheckBox Content="Negate enemy hits on player"
                                      ToolTip="Damage from enemy attacks is zeroed. Fall, environmental and death plane damage is unaffected."
                                      IsChecked="{Binding IsNegateEnemyHitsEnabled}"
                                      Margin="0,2" />

                            <CheckBox Content="Heal enemies when player hit"
                                      ToolTip="When an enemy hits you, every living enemy is restored to full health (the second Bell Gargoyle to the health it spawns with)."
                                      IsChecked="{Binding IsHealEnemiesOnPlayerHitEnabled}"
                                      Margin="0,2" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>